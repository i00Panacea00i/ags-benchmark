# ============ AGS Benchmark Orchestrator 环境配置 ============
# 复制为 deploy/.env 并填写（chmod 600）。凭据仅经环境变量注入，不落镜像/代码。

# ---- E2B 数据面（AGS）----
E2B_DOMAIN=ap-singapore.tencentags.com
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxx                  # AGS 控制台 → API Keys（必填）

# ---- AGS 沙箱工具名（create_tools.sh 按此创建）----
MAKER_TOOL=bench-builder        # agent1 制作沙箱（镜像内置已验证制作逻辑）
VALIDATOR_TOOL=bench-validator  # agent2 验证沙箱（images/Dockerfile.validator）
BENCH_TOOL=bench-base           # 题目基座沙箱（images/Dockerfile.bench_base）

# ---- TCR（agent1 镜像构建推送；仅 maker 流程需要）----
TCR_REGISTRY=your-instance.tencentcloudcr.com        # 企业版实例域名（必填）
TCR_NAMESPACE=benchmark-repo
TCR_REGISTRY_ID=tcr-xxxxxxxx
TCR_REGION=ap-singapore
ROLE_ARN=qcs::cam::uin/000000000000:roleName/your-ags-role   # TCR 拉取最小权限角色
# 推送凭据由驱动器每批经 tccli CreateInstanceToken 自动刷新，无需在此填

# ---- GitHub（agent1 发现/配对；fine-grained PAT，公开仓库只读，可选）----
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# ---- 去重后端（flock=单机默认；cos=多副本无状态横向扩展）----
CLAIM_BACKEND=flock
# CLAIM_BACKEND=cos 时必填：
# COS_BUCKET=my-bucket-125000000
# COS_REGION=ap-singapore
# COS_SECRET_ID=
# COS_SECRET_KEY=
